{
  "startup_timeout": 7200,
  "backend": "vllm",
  "model": "Reson8/Rumble-2-Flash",
  "port": 8121,
  "endpoint": "chat",
  "extra_args": [
    "--max-model-len",
    "4096"
  ],
  "extra_body": {
    "chat_template_kwargs": {
      "language": "French"
    }
  },
  "vllm_command": [
    "env",
    "-u",
    "PYTHONPATH",
    "-u",
    "LD_LIBRARY_PATH",
    "-u",
    "LIBRARY_PATH",
    "-u",
    "VLLM_USE_STANDALONE_COMPILE",
    "-u",
    "TORCH_CUDA_ARCH_LIST",
    "-u",
    "TRITON_CUPTI_PATH",
    "-u",
    "TRITON_CUDACRT_PATH",
    "-u",
    "TRITON_CUOBJDUMP_PATH",
    "-u",
    "TRITON_NVDISASM_PATH",
    "-u",
    "TRITON_PTXAS_PATH",
    "-u",
    "TRITON_CUDART_PATH",
    "~/.venvs/vllm/bin/vllm",
    "serve"
  ],
  "compute_rtf": true,
  "server": "http://localhost",
  "device": "cuda",
  "launch": true,
  "trust_remote_code": false,
  "served_model_name": null,
  "request_model": "Reson8/Rumble-2-Flash",
  "gpu_memory_utilization": 0.6,
  "language": null,
  "temperature": 0.0,
  "prompt": "Transcris cet audio en français.",
  "audio_placeholder": null,
  "max_tokens": 256,
  "concurrency": 1,
  "strip_diarization": true,
  "request_timeout": 600,
  "env": {},
  "log_file": "logs/vllm_Reson8-Rumble-2-Flash.log",
  "input_manifest": "benchmarks/sota/manifest_rtf.jsonl",
  "save_predictions": false,
  "save_alignments": false,
  "compute_latency": false,
  "plot_monitoring": true,
  "input_audios_paths": "",
  "device_name": "NVIDIA GB10",
  "word_timestamps": false
}