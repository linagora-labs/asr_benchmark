    "-u",
    "TRITON_CUPTI_PATH",
    "-u",
    "TRITON_CUDACRT_PATH",
    "-u",
    "TRITON_CUOBJDUMP_PATH",
    "-u",
    "TRITON_NVDISASM_PATH",
    "-u",
    "TRITON_PTXAS_PATH",
    "-u",
