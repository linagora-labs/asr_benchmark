{
  "backend": "vllm",
  "model": "OpenLLM-France/Luciole-23B-Audio-1.0",
  "port": 8117,
  "endpoint": "chat",
  "audio_placeholder": "<|audio|>",
  "prompt": "Fais une transcription mot pour mot en français du contenu parlé. <|audio|>",
  "concurrency": 32,
  "vllm_command": [
    "env",
    "-u",
    "PYTHONPATH",
    "-u",
    "LD_LIBRARY_PATH",
    "-u",
    "LIBRARY_PATH",
    "-u",
    "VLLM_USE_STANDALONE_COMPILE",
    "-u",
    "TORCH_CUDA_ARCH_LIST",
    "-u",
    "TRITON_CUPTI_PATH",
    "-u",
    "TRITON_CUDACRT_PATH",
    "-u",
    "TRITON_CUOBJDUMP_PATH",
    "-u",
    "TRITON_NVDISASM_PATH",
    "-u",
    "TRITON_PTXAS_PATH",
    "-u",
    "TRITON_CUDART_PATH",
    "/tmp/vllm_salm/bin/python",
    "-m",
    "vllm.entrypoints.cli.main",
    "serve"
  ],
  "server": "http://localhost",
  "device": "cuda",
  "launch": true,
  "trust_remote_code": false,
  "served_model_name": null,
  "request_model": "OpenLLM-France/Luciole-23B-Audio-1.0",
  "gpu_memory_utilization": 0.85,
  "extra_args": [],
  "language": null,
  "temperature": 0.0,
  "max_tokens": 512,
  "strip_diarization": true,
  "startup_timeout": 2400,
  "request_timeout": 600,
  "env": {},
  "log_file": "logs/vllm_OpenLLM-France-Luciole-23B-Audio-1.0.log",
  "input_manifest": "benchmarks/sota/manifest.jsonl",
  "compute_rtf": false,
  "save_predictions": false,
  "save_alignments": true,
  "compute_latency": false,
  "plot_monitoring": false,
  "input_audios_paths": "",
  "word_timestamps": false,
  "model_info": {
    "hf": "OpenLLM-France/Luciole-23B-Audio-1.0",
    "license": "apache-2.0",
    "params": 23831727632,
    "architecture": "Audio LLM",
    "task": "Multi",
    "streaming": false,
    "prompt_source": "model card"
  }
}