{
    "backend": "vllm",
    "model": "Qwen/Qwen3-Omni-30B-A3B-Instruct",
    "port": 8105,
    "language": "fr",
    "startup_timeout": 7200,
    "env": {
        "MAX_JOBS": 4
    },
    "vllm_command": [
        "env",
        "-u",
        "PYTHONPATH",
        "-u",
        "LD_LIBRARY_PATH",
        "-u",
        "LIBRARY_PATH",
        "-u",
        "VLLM_USE_STANDALONE_COMPILE",
        "-u",
        "TORCH_CUDA_ARCH_LIST",
        "-u",
        "TRITON_CUPTI_PATH",
        "-u",
        "TRITON_CUDACRT_PATH",
        "-u",
        "TRITON_CUOBJDUMP_PATH",
        "-u",
        "TRITON_NVDISASM_PATH",
        "-u",
        "TRITON_PTXAS_PATH",
        "-u",
        "TRITON_CUDART_PATH",
        "/home/abert/.venvs/vllm/bin/vllm",
        "serve"
    ],
    "server": "http://localhost",
    "device": "cuda",
    "launch": true,
    "trust_remote_code": false,
    "served_model_name": null,
    "request_model": "Qwen/Qwen3-Omni-30B-A3B-Instruct",
    "gpu_memory_utilization": 0.6,
    "extra_args": [],
    "temperature": 0.0,
    "endpoint": "transcriptions",
    "max_tokens": 256,
    "concurrency": 1,
    "strip_diarization": true,
    "request_timeout": 600,
    "log_file": "logs/vllm_Qwen-Qwen3-Omni-30B-A3B-Instruct.log",
    "input_manifest": "benchmarks/sota/manifest.jsonl",
    "compute_rtf": false,
    "save_predictions": false,
    "save_alignments": true,
    "compute_latency": false,
    "plot_monitoring": false,
    "input_audios_paths": "",
    "word_timestamps": false,
    "model_info": {
        "hf": "Qwen/Qwen3-Omni-30B-A3B-Instruct",
        "license": "apache-2.0",
        "params": 35259818545,
        "languages": [
            "en",
            "zh",
            "ko",
            "ja",
            "de",
            "ru",
            "it",
            "fr",
            "es",
            "pt",
            "ms",
            "nl",
            "id",
            "tr",
            "vi",
            "yue",
            "ar",
            "ur"
        ],
        "architecture": "Audio LLM",
        "task": "Multi",
        "streaming": false,
        "prompt_source": "vLLM default prompt for this model",
        "prompt": "<|audio_start|><|audio_pad|><|audio_end|>Transcribe this audio into French."
    }
}