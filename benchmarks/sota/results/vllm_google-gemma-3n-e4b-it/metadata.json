    "compute_rtf": false,
    "save_predictions": false,
    "save_alignments": true,
    "compute_latency": false,
    "plot_monitoring": false,
    "input_audios_paths": "",
    "word_timestamps": false,
    "model_info": {
        "hf": "google/gemma-3n-E4B-it",
        "license": "gemma",
        "params": 7849978192,
        "languages": [
            "140+"
        ],
        "architecture": "Audio LLM",
        "task": "Multi",
        "streaming": false,
        "prompt_source": "vLLM default prompt for this model",
        "prompt": "Transcribe this audio into French: <audio_soft_token>"
    }
