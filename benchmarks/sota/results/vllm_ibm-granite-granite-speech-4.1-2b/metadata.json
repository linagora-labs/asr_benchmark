{
  "backend": "vllm",
  "model": "ibm-granite/granite-speech-4.1-2b",
  "port": 8114,
  "endpoint": "chat",
  "prompt": "<|audio|>transcribe the French speech with proper punctuation and capitalization.",
  "extra_args": [
    "--max-model-len",
    "2048"
  ],
  "concurrency": 16,
  "vllm_command": [
    "env",
    "-u",
    "PYTHONPATH",
    "-u",
    "LD_LIBRARY_PATH",
    "-u",
    "LIBRARY_PATH",
    "-u",
    "VLLM_USE_STANDALONE_COMPILE",
    "-u",
    "TORCH_CUDA_ARCH_LIST",
    "-u",
    "TRITON_CUPTI_PATH",
    "-u",
    "TRITON_CUDACRT_PATH",
    "-u",
    "TRITON_CUOBJDUMP_PATH",
    "-u",
    "TRITON_NVDISASM_PATH",
    "-u",
    "TRITON_PTXAS_PATH",
    "-u",
    "TRITON_CUDART_PATH",
    "/home/abert/.venvs/vllm/bin/vllm",
    "serve"
  ],
  "server": "http://localhost",
  "device": "cuda",
  "launch": true,
  "trust_remote_code": false,
  "served_model_name": null,
  "request_model": "ibm-granite/granite-speech-4.1-2b",
  "gpu_memory_utilization": 0.85,
  "language": null,
  "temperature": 0.0,
  "audio_placeholder": null,
  "max_tokens": 512,
  "strip_diarization": true,
  "startup_timeout": 2400,
  "request_timeout": 600,
  "env": {},
  "log_file": "logs/vllm_ibm-granite-granite-speech-4.1-2b.log",
  "input_manifest": "benchmarks/sota/manifest.jsonl",
  "compute_rtf": false,
  "save_predictions": false,
  "save_alignments": true,
  "compute_latency": false,
  "plot_monitoring": false,
  "input_audios_paths": "",
  "word_timestamps": false,
  "model_info": {
    "hf": "ibm-granite/granite-speech-4.1-2b",
    "license": "apache-2.0",
    "params": 2313207132,
    "languages": [
      "en",
      "fr",
      "de",
      "es",
      "pt",
      "ja"
    ],
    "architecture": "Audio LLM",
    "task": "ASR/AST",
    "streaming": false,
    "prompt_source": "model card's punctuated-ASR prompt, French added"
  }
}