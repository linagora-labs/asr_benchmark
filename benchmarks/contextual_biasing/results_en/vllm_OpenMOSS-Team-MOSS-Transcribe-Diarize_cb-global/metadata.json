{
  "language": null,
  "wer_language": "en",
  "backend": "vllm",
  "model": "OpenMOSS-Team/MOSS-Transcribe-Diarize",
  "trust_remote_code": true,
  "port": 8102,
  "transcription_prompt": "Transcribe the audio. For each segment, start with the timestamp and speaker ID ([S01], [S02], [S03], ...), then the spoken text, and end with the segment timestamp.",
  "contextual_biasing": "global",
  "contextual_biasing_template": "{prompt} Hotwords: {terms}",
  "vllm_command": [
    "env",
    "-u",
    "PYTHONPATH",
    "-u",
    "LD_LIBRARY_PATH",
    "-u",
    "LIBRARY_PATH",
    "-u",
    "VLLM_USE_STANDALONE_COMPILE",
    "-u",
    "TORCH_CUDA_ARCH_LIST",
    "-u",
    "TRITON_CUPTI_PATH",
    "-u",
    "TRITON_CUDACRT_PATH",
    "-u",
    "TRITON_CUOBJDUMP_PATH",
    "-u",
    "TRITON_NVDISASM_PATH",
    "-u",
    "TRITON_PTXAS_PATH",
    "-u",
    "TRITON_CUDART_PATH",
    "~/.venvs/vllm/bin/vllm",
    "serve"
  ],
  "compute_rtf": false,
  "server": "http://localhost",
  "device": "cuda",
  "launch": true,
  "served_model_name": null,
  "request_model": "OpenMOSS-Team/MOSS-Transcribe-Diarize",
  "gpu_memory_utilization": 0.6,
  "extra_args": [],
  "temperature": 0.0,
  "endpoint": "transcriptions",
  "contextual_biasing_field": "prompt",
  "max_tokens": 256,
  "concurrency": 64,
  "strip_diarization": true,
  "startup_timeout": 2400,
  "request_timeout": 600,
  "env": {},
  "log_file": "logs/vllm_OpenMOSS-Team-MOSS-Transcribe-Diarize.log",
  "input_manifest": "/tmp/manifest_me267wex.jsonl",
  "save_predictions": false,
  "save_alignments": true,
  "compute_latency": false,
  "plot_monitoring": false,
  "input_audios_paths": "",
  "word_timestamps": false
}